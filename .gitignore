# ─── CONFIDENTIAL / SECRET FILES ───────────────────────────────
backend/.env
backend/.env.local
backend/.env.production
backend/.env.staging

# ─── CLOUDINARY (sensitive API keys) ───────────────────────────
# CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
# are stored in backend/.env which is already ignored above

# ─── UPLOADED MEDICAL FILES (sensitive patient data) ────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ─── DATABASE ───────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── NODE MODULES ───────────────────────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/

# ─── BUILD OUTPUT ───────────────────────────────────────────────
frontend/dist/
frontend/build/
backend/dist/

# ─── LOGS ───────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
backend/logs/

# ─── PACKAGE LOCK (optional to track) ──────────────────────────
package-lock.json
backend/package-lock.json
frontend/package-lock.json

# ─── OS FILES ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE / EDITOR ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo

# ─── TESSERACT TRAINED DATA (large binary file) ─────────────────
backend/eng.traineddata
*.traineddata

# ─── CACHE ──────────────────────────────────────────────────────
.cache/
.parcel-cache/
.vite/
frontend/.vite/
